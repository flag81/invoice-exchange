{
  "name": "@einv/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The exchange itself: supplier and buyer UI, JSON API, session auth and integrations.",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:https": "next dev --port 3001 --experimental-https",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"const fs=require('fs');for (const d of ['.next','coverage']) fs.rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@einv/api-client": "workspace:*",
    "@einv/db": "workspace:*",
    "@einv/pdf": "workspace:*",
    "@einv/shared": "workspace:*",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
