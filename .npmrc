# Enforce the Node/pnpm versions declared in package.json
engine-strict=true

# Peer dependencies: resolve automatically, warn instead of failing hard.
auto-install-peers=true
strict-peer-dependencies=false

# Workspace packages are always linked from source (no publish/build step required).
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Deterministic, reproducible installs in CI.
resolution-mode=highest
