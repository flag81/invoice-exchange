# =============================================================================
# e-Invoice Exchange — environment template
# Copy to `.env` (git-ignored) and fill in. NEVER commit real secrets.
# Everything in this file is SERVER-ONLY. The browser bundle must only ever see
# values explicitly re-exported by `apps/web/src/lib/env.ts` under `publicEnv`.
# =============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV="development"
# Web app URL. Port 3001 avoids the other projects on this machine (3000/5173).
APP_URL="http://localhost:3001"

# ---- Database (PostgreSQL + Prisma) -----------------------------------------
# Dev database. `pnpm db:dev` starts a PostgreSQL matching these values — a local
# pg_ctl cluster in .devdata/, or Docker — so the defaults below already fit it.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/invoice_exchange?schema=public"
# Separate database used by integration tests only. It is truncated between tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/invoice_exchange_test?schema=public"

# ---- Auth / sessions --------------------------------------------------------
AUTH_SESSION_COOKIE_NAME="einv_session"
AUTH_ACCESS_TOKEN_TTL_SECONDS="900"
AUTH_REFRESH_TOKEN_TTL_DAYS="30"
# 32-byte base64 key: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
ENCRYPTION_KEY=""
# RS256 key pair (base64-encoded PKCS#8 PEM / SPKI PEM) used to sign mobile access tokens.
# Generate with: pnpm --filter @einv/web exec tsx scripts/generate-keys.ts
AUTH_JWT_PRIVATE_KEY=""
AUTH_JWT_PUBLIC_KEY=""

# ---- OAuth providers (Google + Facebook) ------------------------------------
# Base for redirect URIs; it must name the scheme the dev server actually serves, and so
# must `APP_URL` above. Google accepts `http://localhost`; Facebook rejects it, so a
# Facebook client is the reason `pnpm dev:https` exists (it needs mkcert's CA in the OS
# trust store — if that fails Next quietly falls back to http and both URLs stay http).
OAUTH_REDIRECT_BASE_URL="http://localhost:3001"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_GRAPH_VERSION="v21.0"

# ---- Document storage (private; local driver in this build) -----------------
# driver: "local" (dev/CI — the only one implemented so far) | "s3" (refused until phase 4)
STORAGE_DRIVER="local"
# Relative paths resolve against the app's working directory, which is `apps/web`
# for the web dev server: `.devdata/storage` therefore lands in `apps/web/`.
STORAGE_LOCAL_ROOT=".devdata/storage"
STORAGE_SIGNED_URL_TTL_SECONDS="60"
# Bytes accepted per upload, for a photo and a PDF alike. Digits only: a value like "8 MiB" is
# ignored, not read as 8. Keep it under ~14 MB: a Gemini inline request caps at 20 MB once base64-encoded.
STORAGE_MAX_UPLOAD_BYTES="8388608"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---- Email ------------------------------------------------------------------
# SMTP connection string used by nodemailer. Leave empty in dev to log instead.
SMTP_URL=""
MAIL_FROM="invoices@example.test"

# ---- AI (extraction — the reader behind the capture flow) -------------------
# "gemini" | "stub". Empty means "choose by key presence": Gemini when GEMINI_API_KEY is
# set, otherwise the deterministic stub — so a fresh clone runs the whole capture
# pipeline (upload → extract → review → save) with no key at all.
# The stub reads NOTHING: it returns a demo invoice derived from the file's hash, and the
# review screen warns about it. Every number is an example until a key is set.
AI_PROVIDER=""
# https://aistudio.google.com/apikey — sent in the `x-goog-api-key` header, never in a URL.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
AI_MONTHLY_BUDGET_USD="0"

# ---- Observability ----------------------------------------------------------
LOG_LEVEL="info"

# ---- Browser-visible values (NEXT_PUBLIC_* only) -----------------------------
# Values with this prefix are inlined into the client bundle: they must never be
# a secret. Everything else stays server-side and reaches the browser only via
# `publicEnv` in apps/web/src/lib/env.ts.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
